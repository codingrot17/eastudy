{
    "name": "Eastudy — University Learning Platform",
    "short_name": "Eastudy",
    "description": "Your class schedule, announcements, and materials — all in one place.",
    "start_url": "/pwa-start",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone"],
    "background_color": "#1E1B4B",
    "theme_color": "#3B35C4",
    "orientation": "portrait-primary",
    "categories": ["education", "productivity"],
    "lang": "en",
    "icons": [
        {
            "src": "/favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        },
        {
            "src": "/icons/apple-touch-icon-180.png",
            "sizes": "any",
            "type": "image/png"
        }
    ],
    "shortcuts": [
        {
            "name": "Announcements",
            "short_name": "Updates",
            "description": "View latest class announcements",
            "url": "/pwa-start",
            "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
        },
        {
            "name": "Schedule",
            "short_name": "Schedule",
            "description": "View today's class schedule",
            "url": "/pwa-start",
            "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
        },
        {
            "name": "Materials",
            "short_name": "Materials",
            "description": "Access study materials",
            "url": "/pwa-start",
            "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
        }
    ],
    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": [
                        "application/pdf",
                        "image/*",
                        ".doc",
                        ".docx",
                        ".ppt",
                        ".pptx"
                    ]
                }
            ]
        }
    },
    "prefer_related_applications": false,
    "related_applications": []
}
